<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Interface version for plugins: stays the same across BamCam releases (binding); the file version follows the release. -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Clipper2" Version="1.5.4" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BamCam.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built-in translations (English is the source language and needs no file). -->
    <EmbeddedResource Include="Localization\lang\*.json" LogicalName="BamCam.Core.Localization.lang.%(Filename).json" />
  </ItemGroup>
</Project>
