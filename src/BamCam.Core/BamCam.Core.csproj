<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Interface version for plugins: stays the same across BamCam releases (binding); the file version follows the release. -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Undocumented members and partly documented parameters are fine; the docs are for plugin authors. -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
    <Description>Drawing, geometry and CAM model of BamCam, for plugins (reference together with BamCam.PluginApi).</Description>
    <!-- NuGet package for plugin authors (attached to every GitHub release). -->
    <Authors>mottobug</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/mottobug/BamCam</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mottobug/BamCam</RepositoryUrl>
    <PackageTags>BamCam;CAM;CNC;plugin</PackageTags>  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Clipper2" Version="1.5.4" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BamCam.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built-in translations (English is the source language and needs no file). -->
    <EmbeddedResource Include="Localization\lang\*.json" LogicalName="BamCam.Core.Localization.lang.%(Filename).json" />
  </ItemGroup>
</Project>
