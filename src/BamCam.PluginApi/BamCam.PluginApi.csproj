<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Interface version for plugins: stays the same across BamCam releases (binding); the file version follows the release. -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Description>Plugin interface of BamCam: commands and machining operations provided by other vendors.</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\BamCam.Core\BamCam.Core.csproj" />
  </ItemGroup>
</Project>
