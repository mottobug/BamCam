<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="clr-namespace:BamCam.App.Drawing"
        xmlns:c="clr-namespace:BamCam.App.Controls"
        x:Class="BamCam.App.Views.MainWindow"
        Title="BamCam"
        Width="1366" Height="860" MinWidth="1024" MinHeight="700"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <!-- Simple vector toolbar icons (24x24 view box). -->
    <StreamGeometry x:Key="IconNew">M6,2 L14,2 L19,7 L19,22 L6,22 Z M14,2 L14,7 L19,7</StreamGeometry>
    <StreamGeometry x:Key="IconOpen">M2,6 L9,6 L11,8 L21,8 L21,20 L2,20 Z M2,11 L21,11</StreamGeometry>
    <StreamGeometry x:Key="IconSave">M3,3 L18,3 L21,6 L21,21 L3,21 Z M7,3 L7,9 L16,9 L16,3 M7,21 L7,14 L17,14 L17,21</StreamGeometry>
    <StreamGeometry x:Key="IconUndo">M9,6 L4,11 L9,16 M4,11 L15,11 C19,11 21,14 21,17 C21,20 19,21 17,21</StreamGeometry>
    <StreamGeometry x:Key="IconRedo">M15,6 L20,11 L15,16 M20,11 L9,11 C5,11 3,14 3,17 C3,20 5,21 7,21</StreamGeometry>
    <StreamGeometry x:Key="IconLine">M3,20 L21,4</StreamGeometry>
    <StreamGeometry x:Key="IconPolyline">M2,20 L8,6 L14,16 L22,4</StreamGeometry>
    <StreamGeometry x:Key="IconArc">M3,19 C3,8 21,8 21,19</StreamGeometry>
    <StreamGeometry x:Key="IconCircle">M12,3 A9,9 0 1 1 11.99,3 Z</StreamGeometry>
    <StreamGeometry x:Key="IconRect">M3,6 L21,6 L21,18 L3,18 Z</StreamGeometry>
    <StreamGeometry x:Key="IconPoints">M5,5 L8,8 M8,5 L5,8 M15,9 L18,12 M18,9 L15,12 M8,16 L11,19 M11,16 L8,19</StreamGeometry>
    <StreamGeometry x:Key="IconText">M4,5 L20,5 M12,5 L12,20 M8,20 L16,20</StreamGeometry>
    <StreamGeometry x:Key="IconProfile">M5,5 L19,5 L19,19 L5,19 Z M2,2 L22,2 L22,22 L2,22 Z</StreamGeometry>
    <StreamGeometry x:Key="IconPocket">M3,3 L21,3 L21,21 L3,21 Z M6,6 L18,6 L18,18 L6,18 Z M9,9 L15,9 L15,15 L9,15 Z</StreamGeometry>
    <StreamGeometry x:Key="IconDrill">M12,2 L12,15 M8,15 L16,15 L12,22 Z M6,4 L18,4</StreamGeometry>
    <StreamGeometry x:Key="IconEngrave">M3,18 C7,6 11,6 12,12 C13,18 17,18 21,6</StreamGeometry>
    <StreamGeometry x:Key="IconGenerate">M4,4 L20,12 L4,20 Z</StreamGeometry>
    <StreamGeometry x:Key="IconGcode">M3,4 L21,4 L21,20 L3,20 Z M6,9 L11,9 M6,13 L16,13 M6,17 L13,17</StreamGeometry>
    <StreamGeometry x:Key="IconGrid">M3,3 L21,3 L21,21 L3,21 Z M9,3 L9,21 M15,3 L15,21 M3,9 L21,9 M3,15 L21,15</StreamGeometry>
    <StreamGeometry x:Key="IconAxis">M4,20 L4,3 M4,20 L21,20 M4,3 L2,6 M4,3 L6,6 M21,20 L18,18 M21,20 L18,22</StreamGeometry>
    <StreamGeometry x:Key="IconFit">M3,8 L3,3 L8,3 M16,3 L21,3 L21,8 M21,16 L21,21 L16,21 M8,21 L3,21 L3,16 M8,8 L16,8 L16,16 L8,16 Z</StreamGeometry>
    <StreamGeometry x:Key="IconSnap">M12,3 L12,21 M3,12 L21,12 M8,8 L16,8 L16,16 L8,16 Z</StreamGeometry>
  </Window.Resources>

  <DockPanel>
    <!-- Main menu -->
    <Menu DockPanel.Dock="Top" x:Name="MainMenu" />

    <!-- Toolbar -->
    <Border DockPanel.Dock="Top" Classes="toolbar">
      <WrapPanel x:Name="ToolbarPanel" Orientation="Horizontal" />
    </Border>

    <!-- Status bar -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource ChromeBrush}" BorderBrush="{StaticResource ChromeBorderBrush}" BorderThickness="0,1,0,0" Padding="6,2">
      <DockPanel>
        <TextBlock DockPanel.Dock="Right" x:Name="CoordText" Text="X: 0.0  Y: 0.0" MinWidth="220" TextAlignment="Right" />
        <TextBlock DockPanel.Dock="Right" x:Name="SnapText" Margin="12,0" />
        <TextBlock DockPanel.Dock="Right" x:Name="UnitsText" Margin="12,0" />
        <TextBlock x:Name="StatusText" Text="Ready" />
      </DockPanel>
    </Border>

    <Grid ColumnDefinitions="310,4,*">
      <!-- Left column: Drawing / System tabs with tree and property grid -->
      <Grid Grid.Column="0" RowDefinitions="*,4,1.2*">
        <TabControl Grid.Row="0" x:Name="LeftTabs" Padding="0" Margin="0">
          <TabItem Header="Drawing">
            <TreeView x:Name="DrawingTree" SelectionMode="Multiple" />
          </TabItem>
          <TabItem Header="System">
            <TreeView x:Name="SystemTree" />
          </TabItem>
        </TabControl>
        <GridSplitter Grid.Row="1" ResizeDirection="Rows" />
        <c:PropertyGrid Grid.Row="2" x:Name="Properties" />
      </Grid>

      <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

      <!-- Right: prompt line, drawing view, messages -->
      <Grid Grid.Column="2" RowDefinitions="Auto,*,4,110">
        <Border Grid.Row="0" Background="#FFFFF8D0" BorderBrush="{StaticResource ChromeBorderBrush}" BorderThickness="0,0,0,1" Padding="6,2" x:Name="PromptBar" IsVisible="False">
          <TextBlock x:Name="PromptText" />
        </Border>
        <d:DrawingView Grid.Row="1" x:Name="View" />
        <GridSplitter Grid.Row="2" ResizeDirection="Rows" />
        <DockPanel Grid.Row="3">
          <Border DockPanel.Dock="Top" Classes="panelHeader"><TextBlock Text="Messages" /></Border>
          <TextBox x:Name="Messages" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
                   FontFamily="Consolas,Menlo,DejaVu Sans Mono,monospace" FontSize="11" BorderThickness="0"
                   ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </DockPanel>
      </Grid>
    </Grid>
  </DockPanel>
</Window>
