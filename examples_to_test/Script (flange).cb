<?xml version="1.0" encoding="utf-8"?>
<CADFile xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" Version="0.9.8.0" Name="Script">
  <layers>
    <layer name="Default" color="127,255,0">
      <ModificationCount>0</ModificationCount>
      <objects>
        <pline id="1" Closed="true">
          <mat m="Identity" />
          <pts>
            <p b="1">40,0,0</p>
            <p b="1">-40,0,0</p>
          </pts>
          <BamCamObject type="bamcam.script" m="Identity">
            <param name="Script">// C# script: add outlines with Add(...). Lengths in drawing units, angles in degrees.
// Helpers: Circle(x, y, r), Rect(x, y, w, h), Line(x1, y1, x2, y2), Arc(x, y, r, start, sweep),
//          Polyline(closed, x1, y1, x2, y2, ...), Text is not available.
var holes = 8;
var pitchRadius = 30;
Add(Circle(0, 0, 40));
for (var i = 0; i &lt; holes; i++)
{
    var a = i * 2 * Math.PI / holes;
    Add(Circle(pitchRadius * Math.Cos(a), pitchRadius * Math.Sin(a), 3));
}</param>
          </BamCamObject>
        </pline>
