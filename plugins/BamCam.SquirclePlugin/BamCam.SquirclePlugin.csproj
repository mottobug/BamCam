<Project Sdk="Microsoft.NET.Sdk">

  <!-- Draw > Squircle: a parametric object. Idea and formula: Geoff, author of the Squircle plugin for CamBam. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Product>Squircle</Product>
    <Company>BamCam project</Company>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- BamCam provides these at run time: reference them without copying them to the output. -->
    <ProjectReference Include="..\..\src\BamCam.PluginApi\BamCam.PluginApi.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="..\..\src\BamCam.Core\BamCam.Core.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>
</Project>
