<Project Sdk="Microsoft.NET.Sdk">

  <!-- Template for a community plugin: copy the folder to <Author>.<Name>, rename this file to <Author>.<Name>.csproj and
       fill in Product, Company and Version. BamCam shows them when it asks whether the plugin may be loaded.

       It builds in two places without changes:
       - inside the BamCam repository (plugins/community/<Author>.<Name>), as the release build does: against BamCam's
         source code;
       - anywhere else, e.g. in your own projects folder on another drive: against an installed BamCam. BamCam installed
         for the current user (the default) or in Program Files is found by itself; otherwise give its folder once, e.g.
         dotnet build -p:BamCamDir="D:\Tools\BamCam\"  (or set BamCamDir in this file). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Product>GeoffRoy.WrapGCode</Product>
    <Company>Geoffrey Roy</Company>
    <Version>1.0.1</Version>
  </PropertyGroup>

  <PropertyGroup Condition="'$(BamCamDir)' == ''">
    <BamCamDir Condition="Exists('$(LOCALAPPDATA)\Programs\BamCam\BamCam.PluginApi.dll')">$(LOCALAPPDATA)\Programs\BamCam\</BamCamDir>
    <BamCamDir Condition="'$(BamCamDir)' == '' and Exists('$(ProgramFiles)\BamCam\BamCam.PluginApi.dll')">$(ProgramFiles)\BamCam\</BamCamDir>
  </PropertyGroup>

  <!-- BamCam provides these at run time: reference them without copying them to the output. -->
  <ItemGroup Condition="Exists('..\..\..\src\BamCam.PluginApi\BamCam.PluginApi.csproj')">
    <ProjectReference Include="..\..\..\src\BamCam.PluginApi\BamCam.PluginApi.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="..\..\..\src\BamCam.Core\BamCam.Core.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('..\..\..\src\BamCam.PluginApi\BamCam.PluginApi.csproj')">
    <Reference Include="BamCam.PluginApi" HintPath="$(BamCamDir)BamCam.PluginApi.dll" Private="false" />
    <Reference Include="BamCam.Core" HintPath="$(BamCamDir)BamCam.Core.dll" Private="false" />
  </ItemGroup>

  <!-- Only for a plugin with its own windows or controls: remove the two comment lines around this ItemGroup. Avalonia is
       BamCam's user interface library; BamCam brings it at run time, so it is not copied to the output. Keep the version
       BamCam uses (src/BamCam.App/BamCam.App.csproj in the BamCam repository). -->
  
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" ExcludeAssets="runtime" />
  </ItemGroup>
  

  <Target Name="CheckBamCamDir" BeforeTargets="ResolveAssemblyReferences"
          Condition="!Exists('..\..\..\src\BamCam.PluginApi\BamCam.PluginApi.csproj') and !Exists('$(BamCamDir)BamCam.PluginApi.dll')">
    <Error Text="BamCam was not found. Build with -p:BamCamDir=&quot;folder of BamCam.exe\&quot; or set BamCamDir in this .csproj." />
  </Target>
</Project>
