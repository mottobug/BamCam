<Project Sdk="Microsoft.NET.Sdk">

  <!-- Machining > Trochoidal Pocket / Profile (matmill): a port of matmill by jkmnt (https://github.com/jkmnt/matmill),
       MIT License. LICENSE-matmill.txt goes with the plugin. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Product>Trochoidal Milling (matmill)</Product>
    <Company>BamCam project</Company>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- BamCam provides these at run time: reference them without copying them to the output. -->
    <ProjectReference Include="..\..\src\BamCam.PluginApi\BamCam.PluginApi.csproj" Private="false" ExcludeAssets="runtime" />
    <ProjectReference Include="..\..\src\BamCam.Core\BamCam.Core.csproj" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <None Include="LICENSE-matmill.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
